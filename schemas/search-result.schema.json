{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "mode",
        "source",
        "requestedUrl",
        "query",
        "maxResults",
        "status",
        "searchPerformed",
        "httpStatus",
        "results",
        "error"
    ],
    "properties": {
        "mode": {
            "type": "string",
            "enum": [
                "search"
            ]
        },
        "source": {
            "type": "string",
            "enum": [
                "cnxieku"
            ]
        },
        "requestedUrl": {
            "type": [
                "string",
                "null"
            ],
            "format": "uri"
        },
        "query": {
            "type": [
                "string",
                "null"
            ]
        },
        "maxResults": {
            "type": [
                "integer",
                "null"
            ],
            "minimum": 1,
            "maximum": 20
        },
        "status": {
            "type": "string",
            "enum": [
                "success",
                "partial",
                "blocked",
                "error",
                "timeout",
                "not_found"
            ]
        },
        "searchPerformed": {
            "type": "boolean"
        },
        "httpStatus": {
            "type": [
                "integer",
                "null"
            ],
            "minimum": 100,
            "maximum": 599
        },
        "results": {
            "type": "array",
            "maxItems": 20,
            "description": "Candidatos verificados de la primera pagina; no se descargan sus fichas.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "productId",
                    "title",
                    "url",
                    "price",
                    "image",
                    "source"
                ],
                "properties": {
                    "productId": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "title": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string",
                        "pattern": "^https://www\\.cnxieku\\.com/item/[0-9]+$",
                        "format": "uri"
                    },
                    "price": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "additionalProperties": false,
                        "required": [
                            "amount",
                            "currency"
                        ],
                        "properties": {
                            "amount": {
                                "type": [
                                    "number",
                                    "null"
                                ],
                                "minimum": 0
                            },
                            "currency": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            }
                        }
                    },
                    "image": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "uri"
                    },
                    "source": {
                        "type": "string",
                        "enum": [
                            "cnxieku"
                        ]
                    }
                }
            }
        },
        "error": {
            "type": [
                "object",
                "null"
            ],
            "additionalProperties": false,
            "required": [
                "code",
                "message",
                "retryAfter"
            ],
            "properties": {
                "code": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "retryAfter": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        }
    }
}
